# FoodFlow REST endpoint and an API client token with the `ingest` scope.
# Mint one in the FoodFlow checkout:
#   npx tsx scripts/create-api-client.ts create --name "import-adapter" --scopes read,ingest
FOODFLOW_URL=http://127.0.0.1:3000
FOODFLOW_TOKEN=

# Where the raw archive, normalized JSONL, sessions and upload ledger live.
# FFIMPORT_DATA_DIR=./data

# Override a store's API base (tests point this at a local stub).
# PUBLIX_API_BASE=https://services.publix.com/api

# Browser used for store sign-ins (default: installed Chrome, Edge or Chromium).
# FFIMPORT_BROWSER=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Set to 0 to renew sessions in a visible window instead of trying headless first.
# FFIMPORT_HEADLESS=1
